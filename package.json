{
  "name": "codetrace",
  "version": "0.0.0",
  "private": true,
  "description": "Code-visualization reader (codeviz). M1.1 root — currently only exposes fixture / schema scripts; cli + web workspaces will be wired in from M1.2.",
  "scripts": {
    "fixture:health": "bash fixtures/fixture-a-order-app/scripts/health-check.sh",
    "validate:ground-truth": "npm --prefix cli run validate:ground-truth",
    "cli:test": "npm --prefix cli run test",
    "cli:analyze": "npm --prefix cli run analyze --",
    "cli:map-io": "npm --prefix cli run map-io --",
    "cli:trace": "npm --prefix cli run trace --",
    "cli:translate": "npm --prefix cli run translate --",
    "e2e:m1": "npm --prefix cli run e2e:m1",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  }
}
